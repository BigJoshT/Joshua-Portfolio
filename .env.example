# Copy to .env.local for local dev. On Vercel, add these under
# Project → Settings → Environment Variables.

# Public URL of the deployed site (no trailing slash). Used for metadata,
# sitemap.xml and robots.txt. OPTIONAL on Vercel: if unset, the project's
# production URL is used automatically. Set it only for a custom domain.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Resend server-side email delivery. Keep these private (do not prefix with
# NEXT_PUBLIC_). Create an API key at https://resend.com/api-keys.
RESEND_API_KEY=

# Must be a sender address on a domain verified in Resend, for example:
# Josh Portfolio <website@your-verified-domain.com>
FROM_EMAIL=

# Optional; defaults to the business email in src/lib/site.ts.
CONTACT_EMAIL=ojojoshua330@gmail.com
